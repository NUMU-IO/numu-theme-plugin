{
  "name": "@numu/theme-plugin",
  "version": "0.1.0",
  "description": "Vite plugin for NUMU themes — validates the manifest, externalizes the SDK + React, and emits the federation manifest expected by the host storefront.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  },
  "files": ["dist"],
  "license": "MIT"
}
